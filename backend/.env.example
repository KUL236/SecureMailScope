# ---- Deployment mode ----
# "development" (default): plain HTTP -- docker-compose up, vite dev, LAN IP for
# phone testing. Session cookie is set WITHOUT Secure so Safari (no localhost
# exception) actually stores it and login works.
# "production": app is served over real HTTPS -- cookie gets Secure automatically.
# Override either decision directly with COOKIE_SECURE=true/false if needed.
ENVIRONMENT=development
COOKIE_SECURE=

# ---- Required-but-defaulted. Change SECRET_KEY/JWT_SECRET before real deployment. ----
DATABASE_URL=postgresql+psycopg://smsuser:smspass@localhost:5432/securemailscope
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-too-in-production

# ---- Optional infra. Leave empty and background jobs run inline. ----
REDIS_URL=

# ---- OPTIONAL enrichment. Core PCAP/TLS/X.509/ML pipeline works with ALL of these empty. ----
THREAT_INTEL_API_KEY=
LLM_API_KEY=
CT_API_KEY=

# ---- Certificate revocation checking (OCSP/CRL) ----
# OFF by default: this is a genuine live network call to the issuing CA,
# a deliberate exception to "passive capture only". Chain signature
# verification against the local root CA store (certifi) is always on
# and never needs this -- it's local-file-only. See docs/CERTIFICATE_ANALYSIS.md.
ENABLE_LIVE_REVOCATION_CHECKS=false
REVOCATION_CHECK_TIMEOUT_SECONDS=5
